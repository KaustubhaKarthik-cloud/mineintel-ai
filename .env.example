# MineIntel AI - Environment Configuration
# Copy to `.env` and fill in values. Never commit a real `.env`.

# Application
APP_NAME=MineIntel AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database — local demo uses SQLite; PostgreSQL is optional
DATABASE_URL=postgresql+psycopg2://mineintel:mineintel@localhost:5432/mineintel
USE_SQLITE=true
SQLITE_URL=sqlite:///./mineintel_demo.db

# LLM extraction provider (mock | openai)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=mock

# Embeddings (mock | openai)
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROVIDER=mock

# Retrieval / vector index (JSON embeddings in SQLite locally)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SEARCH_TOP_K=5
MIN_SIMILARITY_THRESHOLD=0.20
MAX_SEARCH_QUERY_LENGTH=1000
INDEX_VERIFIED_FACTS=true

# Validation
VALIDATION_ABSOLUTE_TOLERANCE=0.01
VALIDATION_RELATIVE_TOLERANCE=0.002
VALIDATION_REVIEWER_DEFAULT=ops.analyst

# Assistant LLM — local Qwen via Ollama (no API key)
# ASSISTANT_LLM_PROVIDER: mock | openai | compatible | local_qwen | ollama
ASSISTANT_LLM_PROVIDER=local_qwen
ASSISTANT_MAX_HISTORY=8
ASSISTANT_RAG_TOP_K=5
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT_SECONDS=90
TOPIC_MIN_HITS=1
TOPIC_SUMMARY_TOP_K=6

# Auth / RBAC
AUTH_REQUIRED=true
JWT_EXPIRE_HOURS=24
AUTH_SEED_USERS=true

# Document storage
DOCUMENTS_DIR=../documents
UPLOAD_MAX_SIZE_MB=50

# OCR — use forward slashes on Windows
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANGUAGE=eng
# Primary OCR for scanned PDFs/images: paddle | tesseract | auto
OCR_ENGINE=paddle
# Fallback if primary fails / empty: tesseract | paddle | none
OCR_FALLBACK=tesseract
# Table path: existing (PyMuPDF structured_table) | paddle (assistive PP-Structure only)
OCR_TABLE_ENGINE=existing
PADDLE_OCR_LANG=en
PDF_DIGITAL_TEXT_THRESHOLD=40

HIGH_CONFIDENCE_THRESHOLD=0.85
REVIEW_THRESHOLD=0.70

DEMO_MODE=true
